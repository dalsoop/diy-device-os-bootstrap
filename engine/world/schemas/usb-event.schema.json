{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dalsoop/diy-device-os-bootstrap/blob/main/engine/world/schemas/usb-event.schema.json",
  "title": "USB physical write event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "generation_candidate",
    "generation_id",
    "world_slug",
    "media_id",
    "writer",
    "repository_revision",
    "catalog_tree",
    "status",
    "started_at",
    "finished_at",
    "exit_code",
    "failure_code",
    "target",
    "readback"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "event_id": { "type": "string", "pattern": "^[0-9]{14}-[a-z0-9-]+-[0-9a-f]{8}$" },
    "generation_candidate": { "type": "string", "pattern": "^[0-9]{14}-[a-z0-9-]+$" },
    "generation_id": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9]{14}-[a-z0-9-]+$" },
        { "type": "null" }
      ]
    },
    "world_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "media_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "writer": { "enum": ["linux-ventoy", "macos-mbr-last"] },
    "repository_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "catalog_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "status": { "enum": ["pending", "succeeded", "failed", "cancelled", "interrupted"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "exit_code": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
    "failure_code": { "type": ["string", "null"] },
    "target": {
      "oneOf": [
        { "$ref": "#/$defs/target" },
        { "type": "null" }
      ]
    },
    "readback": {
      "oneOf": [
        { "$ref": "#/$defs/readback" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "bytes"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "passed"] }
      }
    }
  }
}
