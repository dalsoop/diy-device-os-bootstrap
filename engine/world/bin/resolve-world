#!/usr/bin/env ruby
# SPDX-FileCopyrightText: 2026 dalsoop
# SPDX-License-Identifier: GPL-3.0-only
# frozen_string_literal: true

require "fileutils"
require "ipaddr"
require "json"
require "optparse"
require "pathname"
require "yaml"

class ContractError < StandardError; end

SAFE_ID = /\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z/
SAFE_REL = /\A[A-Za-z0-9][A-Za-z0-9._+!\/-]*\z/

def fail_contract(message)
  raise ContractError, message
end

def mapping(value, label)
  fail_contract("#{label} must be a mapping") unless value.is_a?(Hash)
  value
end

def list(value, label, empty: false)
  fail_contract("#{label} must be an array") unless value.is_a?(Array)
  fail_contract("#{label} must not be empty") if !empty && value.empty?
  value
end

def text(value, label)
  fail_contract("#{label} must be a non-empty string") unless value.is_a?(String) && !value.empty?
  value
end

def safe_id(value, label)
  value = text(value, label)
  fail_contract("#{label} must be lowercase kebab-case") unless SAFE_ID.match?(value)
  value
end

def safe_relative(value, label)
  value = text(value, label)
  parts = value.split("/")
  fail_contract("#{label} must be a safe relative path") unless SAFE_REL.match?(value) &&
                                                               !value.start_with?("/") &&
                                                               parts.none? { |part| part.empty? || part == "." || part == ".." }
  value
end

def unique_ids(items, label)
  ids = items.map.with_index { |item, index| safe_id(mapping(item, "#{label}[#{index}]")["id"], "#{label}[#{index}].id") }
  duplicate = ids.group_by(&:itself).find { |_id, values| values.length > 1 }&.first
  fail_contract("duplicate #{label} ID: #{duplicate}") if duplicate
  ids
end

def parse_ip(value, label)
  IPAddr.new(text(value, label))
rescue IPAddr::InvalidAddressError
  fail_contract("#{label} is not a valid IP address or CIDR")
end

def parse_host_ip(value, label)
  value = text(value, label)
  fail_contract("#{label} must not contain a prefix length") if value.include?("/")
  parse_ip(value, label)
end

def contained_file(root, relative, label)
  relative = safe_relative(relative, label)
  candidate = root.join(relative).cleanpath
  prefix = root.to_s.end_with?(File::SEPARATOR) ? root.to_s : root.to_s + File::SEPARATOR
  fail_contract("#{label} escapes the World module") unless candidate.to_s.start_with?(prefix)

  cursor = root
  Pathname(relative).each_filename do |component|
    cursor = cursor.join(component)
    fail_contract("#{label} traverses a symlink") if cursor.symlink?
  end
  fail_contract("#{label} is not a readable file") unless candidate.file? && candidate.readable?
  candidate
end

def load_yaml(path, label)
  value = YAML.safe_load_file(path, permitted_classes: [], aliases: false)
  mapping(value, label)
rescue Psych::Exception => e
  fail_contract("#{label} is invalid YAML: #{e.message}")
end

options = {}
begin
  OptionParser.new do |parser|
    parser.banner = "Usage: engine/world/bin/resolve-world [options]"
    parser.on("--playbook PATH", "WorldPlaybook path") { |value| options[:playbook] = value }
    parser.on("--world SLUG", "Draft World slug") { |value| options[:world] = value }
    parser.on("--media ID", "Media definition ID") { |value| options[:media] = value }
    parser.on("--output PATH", "Write JSON atomically instead of stdout") { |value| options[:output] = value }
  end.parse!
  fail_contract("unexpected positional arguments") unless ARGV.empty?

  default_repository_root = Pathname(__dir__).join("../../..").expand_path
  playbook_path = Pathname(options.fetch(:playbook, default_repository_root.join("burn-history/.paths.yaml").to_s)).expand_path
  module_root = playbook_path.dirname
  fail_contract("playbook must be a readable regular file") unless playbook_path.file? && playbook_path.readable? && !playbook_path.symlink?

  playbook = load_yaml(playbook_path, "WorldPlaybook")
  fail_contract("unsupported WorldPlaybook apiVersion") unless playbook["apiVersion"] == "homelab.gujo.dev/v1alpha1"
  fail_contract("document is not a WorldPlaybook") unless playbook["kind"] == "WorldPlaybook"
  playbook_spec = mapping(playbook["spec"], "WorldPlaybook.spec")
  timezone = text(playbook_spec["timezone"], "WorldPlaybook.spec.timezone")
  fail_contract("unsupported World timezone") unless timezone == "Asia/Seoul"
  drafts = list(playbook_spec["drafts"], "WorldPlaybook.spec.drafts")
  draft_ids = drafts.map.with_index do |draft_item, index|
    safe_id(mapping(draft_item, "drafts[#{index}]")["slug"], "drafts[#{index}].slug")
  end
  fail_contract("duplicate draft slug") unless draft_ids.uniq.length == draft_ids.length
  requested_world = options[:world]
  if requested_world.nil?
    fail_contract("select a World with --world because multiple drafts exist") unless drafts.length == 1
    requested_world = draft_ids.first
  else
    safe_id(requested_world, "--world")
  end
  draft = drafts.find { |item| item["slug"] == requested_world }
  fail_contract("World is not declared by the playbook: #{requested_world}") unless draft

  generations = mapping(playbook_spec["generations"], "WorldPlaybook.spec.generations")
  safe_relative(generations["root"], "WorldPlaybook.spec.generations.root")
  fail_contract("unsupported generation ID format") unless generations["idFormat"] == "{YYYYMMDDHHmmss}-{world-slug}"
  fail_contract("unsafe generation publication policy") unless generations["publishAfter"] == "verified-physical-usb-write"

  world_path = contained_file(module_root, draft["path"], "draft.path")
  world = load_yaml(world_path, "World")
  fail_contract("unsupported World apiVersion") unless world["apiVersion"] == "homelab.gujo.dev/v1alpha1"
  fail_contract("document is not a World") unless world["kind"] == "World"
  metadata = mapping(world["metadata"], "World.metadata")
  world_slug = safe_id(metadata["slug"], "World.metadata.slug")
  fail_contract("draft slug and World slug differ") unless world_slug == requested_world
  world_name = text(metadata["name"], "World.metadata.name")
  lifecycle = text(metadata["lifecycle"], "World.metadata.lifecycle")
  fail_contract("only draft Worlds may be resolved") unless lifecycle == "draft"

  spec = mapping(world["spec"], "World.spec")
  assets = list(spec["assets"], "World.spec.assets")
  asset_ids = unique_ids(assets, "assets")
  assets.each_with_index do |asset, index|
    asset = mapping(asset, "assets[#{index}]")
    text(asset["type"], "assets[#{index}].type")
    safe_relative(asset["inventoryRef"], "assets[#{index}].inventoryRef") if asset.key?("inventoryRef")
    parse_host_ip(asset["managementAddress"], "assets[#{index}].managementAddress") if asset.key?("managementAddress")
  end

  networks = list(spec["networks"], "World.spec.networks")
  network_ids = unique_ids(networks, "networks")
  network_by_id = {}
  networks.each_with_index do |network, index|
    network = mapping(network, "networks[#{index}]")
    cidr = parse_ip(network["cidr"], "networks[#{index}].cidr")
    fail_contract("network CIDR must be IPv4: #{network['id']}") unless cidr.ipv4?
    gateway = parse_host_ip(network["gateway"], "networks[#{index}].gateway")
    fail_contract("network gateway is outside its CIDR: #{network['id']}") unless cidr.include?(gateway)
    network_by_id[network["id"]] = cidr
  end

  nodes = list(spec["nodes"], "World.spec.nodes")
  node_ids = unique_ids(nodes, "nodes")
  addresses = []
  nodes.each_with_index do |node, index|
    node = mapping(node, "nodes[#{index}]")
    asset_ref = safe_id(node["assetRef"], "nodes[#{index}].assetRef")
    network_ref = safe_id(node["networkRef"], "nodes[#{index}].networkRef")
    fail_contract("unknown assetRef: #{asset_ref}") unless asset_ids.include?(asset_ref)
    fail_contract("unknown networkRef: #{network_ref}") unless network_ids.include?(network_ref)
    text(node["role"], "nodes[#{index}].role")
    address = parse_host_ip(node["ipv4"], "nodes[#{index}].ipv4")
    fail_contract("node address must be IPv4: #{node['id']}") unless address.ipv4?
    fail_contract("node address is outside its network: #{node['id']}") unless network_by_id.fetch(network_ref).include?(address)
    fail_contract("duplicate node address: #{node['ipv4']}") if addresses.include?(address)
    addresses << address
  end

  services = list(spec["services"], "World.spec.services", empty: true)
  unique_ids(services, "services")
  services.each_with_index do |service, index|
    service = mapping(service, "services[#{index}]")
    text(service["type"], "services[#{index}].type")
    members = list(service["members"], "services[#{index}].members")
    members.each_with_index do |member, member_index|
      member = safe_id(member, "services[#{index}].members[#{member_index}]")
      fail_contract("unknown service member: #{member}") unless node_ids.include?(member)
    end
    fail_contract("duplicate service member in #{service['id']}") unless members.uniq.length == members.length
  end

  media_items = list(spec["media"], "World.spec.media")
  media_ids = unique_ids(media_items, "media")
  requested_media = options[:media]
  if requested_media.nil?
    if media_items.length == 1
      requested_media = media_ids.first
    else
      requested_media = safe_id(spec["defaultMedia"], "World.spec.defaultMedia")
      fail_contract("World.spec.defaultMedia is not declared by media") unless media_ids.include?(requested_media)
    end
  else
    safe_id(requested_media, "--media")
  end
  media = media_items.find { |item| item["id"] == requested_media }
  fail_contract("media is not declared by the World: #{requested_media}") unless media
  entries = list(media["entries"], "media.entries").map.with_index { |entry, index| safe_id(entry, "media.entries[#{index}]") }
  fail_contract("duplicate media entry") unless entries.uniq.length == entries.length
  language = text(media["language"], "media.language")
  fail_contract("unsupported media language: #{language}") unless ["ko-KR", "en-US"].include?(language)

  policies = mapping(spec["policies"], "World.spec.policies")
  {
    "requireExactHardwareMatch" => true,
    "requireSingleInternalTargetDisk" => true,
    "requireTargetSpecificEraseConfirmation" => true,
    "automaticBootTimeout" => "disabled"
  }.each do |key, expected|
    fail_contract("unsafe policy #{key}") unless policies[key] == expected
  end
  if entries.include?("dns-appliance")
    fail_contract("DNS media requires guarded unattended installation") unless policies["unattendedInstall"] == "guarded"
  end

  relative_playbook = playbook_path.relative_path_from(module_root.parent).to_s
  relative_world = world_path.relative_path_from(module_root.parent).to_s
  result = {
    "schema_version" => 1,
    "source" => { "playbook" => relative_playbook, "world" => relative_world },
    "world" => { "name" => world_name, "slug" => world_slug, "lifecycle" => lifecycle, "timezone" => timezone },
    "media" => { "id" => requested_media, "language" => language, "entries" => entries },
    "policies" => policies
  }
  output = JSON.pretty_generate(result) + "\n"

  if options[:output]
    destination = Pathname(options[:output]).expand_path
    FileUtils.mkdir_p(destination.dirname)
    temporary = destination.dirname.join(".#{destination.basename}.#{Process.pid}.tmp")
    File.open(temporary, File::WRONLY | File::CREAT | File::TRUNC, 0o600) { |file| file.write(output) }
    File.rename(temporary, destination)
  else
    $stdout.write(output)
  end
rescue ContractError, OptionParser::ParseError, Errno::ENOENT, Errno::EACCES => e
  warn "resolve-world: #{e.message}"
  exit 1
end
