{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dalsoop/diy-device-os-bootstrap/blob/main/engine/installer/schemas/raw-image-manifest.schema.json",
  "title": "Device OS raw-image provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "image", "catalog", "license", "world"],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "device-os-raw-image" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "bytes", "sha256"],
      "properties": {
        "filename": { "type": "string", "pattern": "^[^/]+$" },
        "bytes": { "type": "integer", "minimum": 4294967296 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "revision", "tree"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "decision", "distribution_policy_sha256", "selected_artifacts"],
      "properties": {
        "mode": { "const": "personal-use" },
        "decision": { "const": "allow" },
        "distribution_policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "selected_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "sha256", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "kind": { "enum": ["bootloader", "catalog-entry", "runtime-artifact", "component", "final-artifact"] },
              "sha256": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
              "status": { "enum": ["personal-use-only", "redistribution-reviewed"] }
            }
          }
        }
      }
    },
    "world": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["slug", "media_id"],
          "properties": {
            "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "media_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        },
        { "type": "null" }
      ]
    }
  }
}
