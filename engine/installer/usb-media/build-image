set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

case "$(uname -s)" in
    Darwin) exec "$script_dir/build-image-container" "$@" ;;
    Linux) exec "$script_dir/build-image-linux" "$@" ;;
    *)
        echo "usb-media build-image: only macOS and Linux are supported" >&2
        exit 1
        ;;
esac
