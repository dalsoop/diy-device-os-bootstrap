set -eu

decision=${1:-}
policy=${2:-}

fail() {
    echo "render-distribution-record: $*" >&2
    exit 1
}

{ [ -f "$decision" ] && [ ! -L "$decision" ]; } || fail "license decision must be a regular, non-symlink file"
{ [ -f "$policy" ] && [ ! -L "$policy" ]; } || fail "distribution policy must be a regular, non-symlink file"
command -v jq >/dev/null 2>&1 || fail "jq is required"

jq -e '
  def safe_id: type == "string" and test("^[a-z0-9][a-z0-9-]*$");
  def digest: type == "string" and test("^[a-f0-9]{64}$");
  def artifact:
    type == "object" and keys == ["id","kind","sha256","status"] and
    (.id | safe_id) and
    (.kind == "bootloader" or .kind == "catalog-entry" or .kind == "runtime-artifact" or
      .kind == "component" or .kind == "final-artifact") and
    (.sha256 == null or (.sha256 | digest)) and
    (.status == "personal-use-only" or .status == "redistribution-reviewed");
  def finding:
    type == "object" and keys == ["artifact_id","code","message"] and
    (.artifact_id == null or (.artifact_id | safe_id)) and
    (.code | safe_id) and
    (.message | type == "string" and length > 0);
  type == "object" and
  keys == ["blockers","decision","mode","schema_version","selected_artifacts","warnings"] and
  .schema_version == 1 and
  (.mode == "personal-use" or .mode == "source-release" or .mode == "prebuilt-release") and
  (.decision == "allow" or .decision == "deny") and
  (.selected_artifacts | type == "array" and all(.[]; artifact)) and
  (.blockers | type == "array" and all(.[]; finding)) and
  (.warnings | type == "array" and all(.[]; finding)) and
  (if .decision == "allow" then .blockers == [] else (.blockers | length > 0) end)
' "$decision" >/dev/null || fail "license decision violates its exact contract"

jq -e '
  type == "object" and
  (keys | sort) == ["generated_artifacts","prebuilt_release","schema_version","source_release"] and
  .schema_version == 1 and
  (.source_release | type == "object" and keys == ["enabled"] and (.enabled | type == "boolean")) and
  (.generated_artifacts | type == "object" and keys == ["enabled"] and (.enabled | type == "boolean")) and
  (.prebuilt_release | type == "object" and
    (keys | sort) == ["enabled","required_github_environment"] and
    (.enabled | type == "boolean") and .required_github_environment == "prebuilt-distribution")
' "$policy" >/dev/null || fail "global distribution policy violates its exact contract"

if command -v sha256sum >/dev/null 2>&1; then
    policy_sha256=$(sha256sum "$policy" | awk 'NR == 1 {print $1}')
else
    policy_sha256=$(shasum -a 256 "$policy" | awk 'NR == 1 {print $1}')
fi

jq -n --arg policy_sha256 "$policy_sha256" --slurpfile decision "$decision" '
  {
    schema_version: 1,
    distribution_policy_sha256: $policy_sha256,
    mode: $decision[0].mode,
    decision: $decision[0].decision,
    selected_artifacts: $decision[0].selected_artifacts
  }
'
