{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dalsoop/device-os-catalog/schemas/bootloader.schema.json",
  "title": "Device OS Bootloader",
  "type": "object",
  "required": ["schema_version", "id", "implementation", "version", "archive_root", "source"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "implementation": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "archive_root": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["kind", "filename", "url", "sha256"],
      "properties": {
        "kind": { "const": "locked-download" },
        "filename": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

