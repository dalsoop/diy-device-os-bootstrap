#!/bin/sh
# SPDX-FileCopyrightText: 2026 dalsoop
# SPDX-License-Identifier: GPL-3.0-only
set -eu

media_dir=${DNS_INSTALLER_MEDIA_DIR:-/cdrom/simple-cdd}
state_dir=${DNS_INSTALLER_STATE_DIR:-/run/dns-appliance}
sys_root=${DNS_INSTALLER_SYS_ROOT:-/sys}
mounts_file=${DNS_INSTALLER_MOUNTS_FILE:-/proc/mounts}
swaps_file=${DNS_INSTALLER_SWAPS_FILE:-/proc/swaps}
debconf_set_command=${DNS_INSTALLER_DEBCONF_SET:-debconf-set}
device_root=${DNS_INSTALLER_DEVICE_ROOT:-/dev}
zero_command=${DNS_INSTALLER_ZERO_COMMAND:-dd}
blockdev_command=${DNS_INSTALLER_BLOCKDEV_COMMAND:-blockdev}
sync_command=${DNS_INSTALLER_SYNC_COMMAND:-sync}
package_pool=${DNS_INSTALLER_PACKAGE_POOL:-/cdrom/pool}
udpkg_command=${DNS_INSTALLER_UDPKG_COMMAND:-udpkg}
network_detect_command=${DNS_INSTALLER_NETWORK_DETECT_COMMAND:-/bin/hw-detect}
uname_command=${DNS_INSTALLER_UNAME_COMMAND:-uname}
modprobe_command=${DNS_INSTALLER_MODPROBE_COMMAND:-modprobe}
blkid_command=${DNS_INSTALLER_BLKID_COMMAND:-blkid}
mount_command=${DNS_INSTALLER_MOUNT_COMMAND:-mount}
umount_command=${DNS_INSTALLER_UMOUNT_COMMAND:-umount}
anna_install_command=${DNS_INSTALLER_ANNA_INSTALL_COMMAND:-anna-install}
state_file=$state_dir/install.env

fail() {
    message="DNS appliance install blocked: $*"
    logger -t dns-appliance-installer "$message" 2>/dev/null || true
    echo "$message" >&2
    exit 1
}

normalize() {
    LC_ALL=C tr 'abcdefghijklmnopqrstuvwxyz' 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' |
        sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

hash_value() {
    value=$1
    [ -n "$value" ] || fail "empty hardware identity"
    printf '%s' "$value" | normalize | sha256sum | awk '{print $1}'
}

read_first_line() {
    file=$1
    [ -r "$file" ] || fail "cannot read $file"
    sed -n '1p' "$file"
}

set_debconf() {
    "$debconf_set_command" "$@"
}

ensure_network_questions() {
    command -v "$anna_install_command" >/dev/null 2>&1 || fail "$anna_install_command is required"
    "$anna_install_command" netcfg || fail "cannot load installer network questions"
}

network_device_present() {
    for nic_path in "$sys_root"/class/net/*; do
        [ -d "$nic_path" ] || continue
        [ "${nic_path##*/}" = lo ] && continue
        return 0
    done
    return 1
}

ensure_network_hardware() {
    network_device_present && return 0

    kernel_release=$("$uname_command" -r) || fail "cannot identify installer kernel"
    case "$kernel_release" in
        ''|*[!A-Za-z0-9.+~-]*) fail "installer kernel release is invalid" ;;
    esac

    module_count=0
    module_package=
    for candidate in \
        "$package_pool"/*/*/*/nic-modules-"$kernel_release"-di_*.udeb; do
        [ -f "$candidate" ] || continue
        module_count=$((module_count + 1))
        module_package=$candidate
    done
    [ "$module_count" -eq 1 ] ||
        fail "found $module_count NIC module packages for kernel $kernel_release; expected exactly one"

    command -v "$udpkg_command" >/dev/null 2>&1 || fail "$udpkg_command is required"
    [ -x "$network_detect_command" ] || fail "$network_detect_command is required"
    "$udpkg_command" --unpack "$module_package" || fail "cannot unpack installer NIC modules"
    "$network_detect_command" || fail "network hardware detection failed"
    network_device_present || fail "network hardware detection produced no interfaces"
}

load_config() {
    config=$1
    ROLE=
    ADDRESS=
    PREFIX_LENGTH=
    NETMASK=
    GATEWAY=
    DNS_SERVERS=
    DOMAIN=
    LAN_CIDR=
    MANAGEMENT_CIDR=
    CLUSTER_DOMAIN=
    EXPECTED_PRODUCT_NAME_SHA256=
    EXPECTED_PRODUCT_SKU_SHA256=
    EXPECTED_SYSTEM_SERIAL_SHA256=
    EXPECTED_SYSTEM_UUID_SHA256=
    EXPECTED_MAC_SHA256=
    EXPECTED_DISK_MODEL_SHA256=
    EXPECTED_DISK_SERIAL_SHA256=
    EXPECTED_DISK_MIN_BYTES=
    DESTRUCTIVE_INSTALL_ENABLED=

    while IFS='=' read -r key value; do
        case "$key" in
            role) ROLE=$value ;;
            address) ADDRESS=$value ;;
            prefix_length) PREFIX_LENGTH=$value ;;
            netmask) NETMASK=$value ;;
            gateway) GATEWAY=$value ;;
            dns_servers) DNS_SERVERS=$value ;;
            domain) DOMAIN=$value ;;
            lan_cidr) LAN_CIDR=$value ;;
            management_cidr) MANAGEMENT_CIDR=$value ;;
            cluster_domain) CLUSTER_DOMAIN=$value ;;
            expected_product_name_sha256) EXPECTED_PRODUCT_NAME_SHA256=$value ;;
            expected_product_sku_sha256) EXPECTED_PRODUCT_SKU_SHA256=$value ;;
            expected_system_serial_sha256) EXPECTED_SYSTEM_SERIAL_SHA256=$value ;;
            expected_system_uuid_sha256) EXPECTED_SYSTEM_UUID_SHA256=$value ;;
            expected_mac_sha256) EXPECTED_MAC_SHA256=$value ;;
            expected_disk_model_sha256) EXPECTED_DISK_MODEL_SHA256=$value ;;
            expected_disk_serial_sha256) EXPECTED_DISK_SERIAL_SHA256=$value ;;
            expected_disk_min_bytes) EXPECTED_DISK_MIN_BYTES=$value ;;
            destructive_install_enabled) DESTRUCTIVE_INSTALL_ENABLED=$value ;;
        esac
    done < "$config"
}

match_node() {
    ensure_network_hardware

    product_name_hash=$(hash_value "$(read_first_line "$sys_root/class/dmi/id/product_name")")
    product_sku_hash=$(hash_value "$(read_first_line "$sys_root/class/dmi/id/product_sku")")
    system_serial_hash=$(hash_value "$(read_first_line "$sys_root/class/dmi/id/product_serial")")
    system_uuid_hash=$(hash_value "$(read_first_line "$sys_root/class/dmi/id/product_uuid")")

    matches=0
    matched_config=
    matched_nic=

    for config in "$media_dir"/dns01.conf "$media_dir"/dns02.conf "$media_dir"/dns03.conf; do
        [ -r "$config" ] || fail "missing embedded inventory $(basename "$config")"
        load_config "$config"
        [ "$DESTRUCTIVE_INSTALL_ENABLED" = true ] || continue
        [ "$product_name_hash" = "$EXPECTED_PRODUCT_NAME_SHA256" ] || continue
        [ "$product_sku_hash" = "$EXPECTED_PRODUCT_SKU_SHA256" ] || continue
        [ "$system_serial_hash" = "$EXPECTED_SYSTEM_SERIAL_SHA256" ] || continue
        [ "$system_uuid_hash" = "$EXPECTED_SYSTEM_UUID_SHA256" ] || continue

        nic_match=
        nic_count=0
        for nic_path in "$sys_root"/class/net/*; do
            nic=${nic_path##*/}
            [ "$nic" = lo ] && continue
            [ -r "$nic_path/address" ] || continue
            mac_hash=$(hash_value "$(read_first_line "$nic_path/address")")
            if [ "$mac_hash" = "$EXPECTED_MAC_SHA256" ]; then
                nic_match=$nic
                nic_count=$((nic_count + 1))
            fi
        done
        [ "$nic_count" -eq 1 ] || continue

        matches=$((matches + 1))
        matched_config=$config
        matched_nic=$nic_match
    done

    [ "$matches" -eq 1 ] || fail "hardware matched $matches inventory entries; expected exactly one"
    load_config "$matched_config"
    NIC_NAME=$matched_nic
    NIC_MAC=$(read_first_line "$sys_root/class/net/$NIC_NAME/address")

    for value in "$ROLE" "$ADDRESS" "$PREFIX_LENGTH" "$NETMASK" "$GATEWAY" \
        "$DNS_SERVERS" "$DOMAIN" "$LAN_CIDR" "$MANAGEMENT_CIDR" "$CLUSTER_DOMAIN"; do
        [ -n "$value" ] || fail "inventory entry for $ROLE is incomplete"
    done

    check_reinstall_permission
    ensure_network_questions

    mkdir -p "$state_dir"
    {
        printf 'ROLE=%s\n' "$ROLE"
        printf 'ADDRESS=%s\n' "$ADDRESS"
        printf 'PREFIX_LENGTH=%s\n' "$PREFIX_LENGTH"
        printf 'NETMASK=%s\n' "$NETMASK"
        printf 'GATEWAY=%s\n' "$GATEWAY"
        printf 'DNS_SERVERS=%s\n' "$DNS_SERVERS"
        printf 'DOMAIN=%s\n' "$DOMAIN"
        printf 'LAN_CIDR=%s\n' "$LAN_CIDR"
        printf 'MANAGEMENT_CIDR=%s\n' "$MANAGEMENT_CIDR"
        printf 'CLUSTER_DOMAIN=%s\n' "$CLUSTER_DOMAIN"
        printf 'NIC_NAME=%s\n' "$NIC_NAME"
        printf 'NIC_MAC=%s\n' "$NIC_MAC"
    } > "$state_file"

    set_debconf netcfg/choose_interface "$NIC_NAME"
    set_debconf netcfg/get_hostname "$ROLE"
    set_debconf netcfg/get_domain "$DOMAIN"
    set_debconf netcfg/get_ipaddress "$ADDRESS"
    set_debconf netcfg/get_netmask "$NETMASK"
    set_debconf netcfg/get_gateway "$GATEWAY"
    set_debconf netcfg/get_nameservers "$DNS_SERVERS"
    set_debconf netcfg/confirm_static true
}

check_reinstall_permission() {
    enrollment_dir=${DNS_INSTALLER_ENROLLMENT_DIR:-}
    mounted_enrollment=false

    if [ -z "$enrollment_dir" ]; then
        command -v "$modprobe_command" >/dev/null 2>&1 || fail "$modprobe_command is required"
        "$modprobe_command" vfat || fail "cannot load FAT32 enrollment support"
        command -v "$blkid_command" >/dev/null 2>&1 || fail "$blkid_command is required to find DNS-ENROLL"
        enrollment_device=$("$blkid_command" -L DNS-ENROLL 2>/dev/null || true)
        [ -n "$enrollment_device" ] || fail "DNS-ENROLL partition is missing"
        enrollment_dir=$state_dir/enrollment
        mkdir -p "$enrollment_dir"
        "$mount_command" -o ro,nodev,nosuid,noexec "$enrollment_device" "$enrollment_dir" ||
            fail "cannot mount DNS-ENROLL read-only"
        mounted_enrollment=true
    fi

    active_file=$enrollment_dir/records/$ROLE/ACTIVE
    if [ ! -s "$active_file" ]; then
        [ "$mounted_enrollment" = false ] || "$umount_command" "$enrollment_dir"
        return 0
    fi

    previous_generation=$(sed -n '1p' "$active_file")
    token=$enrollment_dir/reinstall/$ROLE.allow
    [ -r "$token" ] || fail "$ROLE already completed generation $previous_generation; reinstall token missing"

    token_role=$(awk -F= '$1 == "role" { print $2 }' "$token")
    token_uuid=$(awk -F= '$1 == "system_uuid_sha256" { print $2 }' "$token")
    token_generation=$(awk -F= '$1 == "previous_generation" { print $2 }' "$token")
    token_authorize=$(awk -F= '$1 == "authorize_erase" { print $2 }' "$token")

    [ "$token_role" = "$ROLE" ] || fail "reinstall token role mismatch"
    [ "$token_uuid" = "$system_uuid_hash" ] || fail "reinstall token hardware mismatch"
    [ "$token_generation" = "$previous_generation" ] || fail "reinstall token generation mismatch"
    [ "$token_authorize" = true ] || fail "reinstall token does not authorize erase"

    [ "$mounted_enrollment" = false ] || "$umount_command" "$enrollment_dir"
}

physical_path() {
    CDPATH='' cd -P "$1" 2>/dev/null && pwd
}

block_name_from_source() {
    source=$1
    case "$source" in
        /dev/mapper/*)
            mapper_name=${source#/dev/mapper/}
            mapper_matches=0
            block_name=
            for mapper_path in "$sys_root"/class/block/dm-*; do
                [ -r "$mapper_path/dm/name" ] || continue
                [ "$(read_first_line "$mapper_path/dm/name")" = "$mapper_name" ] || continue
                mapper_matches=$((mapper_matches + 1))
                block_name=${mapper_path##*/}
            done
            [ "$mapper_matches" -eq 1 ] ||
                fail "installer mapper $mapper_name resolved to $mapper_matches block devices"
            printf '%s\n' "$block_name"
            ;;
        /dev/*)
            block_name=${source#/dev/}
            case "$block_name" in
                */*)
                    source_path=$device_root/$block_name
                    resolved_source=$(readlink -f "$source_path" 2>/dev/null) ||
                        fail "cannot resolve device source $source"
                    block_name=${resolved_source##*/}
                    ;;
            esac
            [ -e "$sys_root/class/block/$block_name" ] ||
                fail "block device $block_name from $source is unresolved"
            printf '%s\n' "$block_name"
            ;;
        *)
            fail "unsupported device source $source"
            ;;
    esac
}

physical_parent_disk() {
    block_name=$1
    depth=0

    while [ "$depth" -lt 16 ]; do
        block_path=$sys_root/class/block/$block_name
        [ -e "$block_path" ] || fail "cannot resolve block device $block_name"

        if [ -e "$block_path/partition" ]; then
            resolved_path=$(physical_path "$block_path") ||
                fail "cannot resolve partition parent for $block_name"
            parent_name=$(basename "$(dirname "$resolved_path")")
            [ "$parent_name" != "$block_name" ] ||
                fail "partition parent loop for $block_name"
            block_name=$parent_name
            depth=$((depth + 1))
            continue
        fi

        slave_count=0
        slave_name=
        for slave_path in "$block_path"/slaves/*; do
            [ -e "$slave_path" ] || continue
            slave_count=$((slave_count + 1))
            slave_name=${slave_path##*/}
        done
        if [ "$slave_count" -gt 0 ]; then
            [ "$slave_count" -eq 1 ] ||
                fail "$block_name has $slave_count backing devices; expected exactly one"
            block_name=$slave_name
            depth=$((depth + 1))
            continue
        fi

        case "$block_name" in
            loop*|dm-*|md*)
                fail "block device $block_name has no resolvable physical parent"
                ;;
        esac
        printf '%s\n' "$block_name"
        return 0
    done

    fail "block-device ancestry exceeded the safety limit"
}

boot_parent_disk() {
    source=$(awk '$2 == "/cdrom" { print $1; exit }' "$mounts_file")
    [ -n "$source" ] || fail "/cdrom mount source is missing"
    block_name=$(block_name_from_source "$source")
    physical_parent_disk "$block_name"
}

disk_is_usb_backed() {
    disk=$1
    device_path=$(physical_path "$sys_root/class/block/$disk/device") ||
        fail "cannot resolve transport for candidate disk $disk"
    case "$device_path" in
        */usb*/*) return 0 ;;
        *) return 1 ;;
    esac
}

block_reaches_disk() (
    block_name=$1
    target_disk=$2
    visited=${3:-}

    case " $visited " in
        *" $block_name "*) fail "block-device ancestry loop at $block_name" ;;
    esac
    [ -e "$sys_root/class/block/$block_name" ] ||
        fail "cannot resolve block device $block_name"
    [ "$block_name" != "$target_disk" ] || return 0

    block_path=$sys_root/class/block/$block_name
    if [ -e "$block_path/partition" ]; then
        resolved_path=$(physical_path "$block_path") ||
            fail "cannot resolve partition parent for $block_name"
        parent_name=$(basename "$(dirname "$resolved_path")")
        [ "$parent_name" != "$block_name" ] ||
            fail "partition parent loop for $block_name"
        if block_reaches_disk "$parent_name" "$target_disk" "$visited $block_name"; then
            return 0
        fi
        return 1
    fi

    for slave_path in "$block_path"/slaves/*; do
        [ -e "$slave_path" ] || continue
        slave_name=${slave_path##*/}
        if block_reaches_disk "$slave_name" "$target_disk" "$visited $block_name"; then
            return 0
        fi
    done
    return 1
)

assert_source_not_on_target() {
    source=$1
    disk=$2
    case "$source" in
        /dev/*) ;;
        *) return 0 ;;
    esac
    block_name=$(block_name_from_source "$source")
    if block_reaches_disk "$block_name" "$disk"; then
        fail "target disk $disk is active through $source"
    fi
}

assert_target_has_no_holders() {
    disk=$1
    for block_path in "$sys_root"/class/block/*; do
        block_name=${block_path##*/}
        is_target_component=false
        if [ "$block_name" = "$disk" ]; then
            is_target_component=true
        elif [ -e "$block_path/partition" ]; then
            resolved_path=$(physical_path "$block_path") ||
                fail "cannot resolve partition parent for $block_name"
            parent_name=$(basename "$(dirname "$resolved_path")")
            [ "$parent_name" = "$disk" ] && is_target_component=true
        fi
        [ "$is_target_component" = true ] || continue
        for holder_path in "$block_path"/holders/*; do
            [ -e "$holder_path" ] || continue
            fail "target component $block_name is held by ${holder_path##*/}"
        done
    done
}

assert_target_inactive() {
    disk=$1
    while IFS=' ' read -r source _rest; do
        assert_source_not_on_target "$source" "$disk"
    done < "$mounts_file"

    [ -r "$swaps_file" ] || fail "cannot read swap table $swaps_file"
    while IFS=' ' read -r source _rest; do
        case "$source" in
            Filename|'') continue ;;
        esac
        assert_source_not_on_target "$source" "$disk"
    done < "$swaps_file"

    assert_target_has_no_holders "$disk"
}

prepare_target_disk() {
    disk=$1
    sectors=$2
    edge_sectors=131072
    [ "$sectors" -gt $((edge_sectors * 2)) ] ||
        fail "target disk $disk is too small for guarded preparation"
    assert_target_inactive "$disk"

    target=$device_root/$disk
    if [ "$device_root" = /dev ]; then
        [ -b "$target" ] || fail "target $target is not a block device"
    fi
    command -v "$zero_command" >/dev/null 2>&1 || fail "$zero_command is required"
    command -v "$blockdev_command" >/dev/null 2>&1 || fail "$blockdev_command is required"
    command -v "$sync_command" >/dev/null 2>&1 || fail "$sync_command is required"

    "$zero_command" if=/dev/zero of="$target" bs=512 count="$edge_sectors" ||
        fail "cannot clear leading signatures from $target"
    "$zero_command" if=/dev/zero of="$target" bs=512 \
        seek=$((sectors - edge_sectors)) count="$edge_sectors" ||
        fail "cannot clear trailing signatures from $target"
    "$sync_command" || fail "cannot synchronize target preparation"
    "$blockdev_command" --rereadpt "$target" ||
        fail "cannot refresh the partition table for $target"
}

match_disk() {
    disk_matches=0
    matched_disk=
    matched_sectors=
    media_disk=$(boot_parent_disk)

    for disk_path in "$sys_root"/class/block/*; do
        disk=${disk_path##*/}
        case "$disk" in
            loop*|ram*|fd*|sr*|dm-*|md*) continue ;;
        esac
        [ ! -e "$disk_path/partition" ] || continue
        [ "$(read_first_line "$disk_path/removable")" = 0 ] || continue
        [ "$disk" != "$media_disk" ] || continue
        [ -r "$disk_path/device/model" ] || continue
        [ -r "$disk_path/device/serial" ] || continue
        disk_is_usb_backed "$disk" && continue

        model_hash=$(hash_value "$(read_first_line "$disk_path/device/model")")
        serial_hash=$(hash_value "$(read_first_line "$disk_path/device/serial")")
        sectors=$(read_first_line "$disk_path/size")
        case "$sectors" in
            ''|*[!0-9]*) continue ;;
        esac
        bytes=$((sectors * 512))

        [ "$model_hash" = "$EXPECTED_DISK_MODEL_SHA256" ] || continue
        [ "$serial_hash" = "$EXPECTED_DISK_SERIAL_SHA256" ] || continue
        [ "$bytes" -ge "$EXPECTED_DISK_MIN_BYTES" ] || continue

        disk_matches=$((disk_matches + 1))
        matched_disk=/dev/$disk
        matched_sectors=$sectors
    done

    [ "$disk_matches" -eq 1 ] || fail "disk matched $disk_matches targets; expected exactly one"
    matched_name=${matched_disk#/dev/}
    prepare_target_disk "$matched_name" "$matched_sectors"
    {
        printf 'TARGET_DISK=%s\n' "$matched_disk"
        printf 'TARGET_DISK_MODEL=%s\n' "$(read_first_line "$sys_root/class/block/$matched_name/device/model")"
        printf 'TARGET_DISK_SERIAL=%s\n' "$(read_first_line "$sys_root/class/block/$matched_name/device/serial")"
        printf 'TARGET_DISK_PREPARED=true\n'
    } >> "$state_file"
    set_debconf partman-auto/disk "$matched_disk"
}

case "${1:-}" in
    identify)
        match_node
        ;;
    select-disk)
        match_node
        match_disk
        ;;
    *)
        fail "unknown gate phase"
        ;;
esac
