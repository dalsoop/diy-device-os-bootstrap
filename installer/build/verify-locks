#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
. "$script_dir/locks/sources.env"

fail() {
    echo "verify-locks: $*" >&2
    exit 1
}

case "$DEBIAN_NETINST_URL" in
    https://cdimage.debian.org/debian-cd/"$DEBIAN_POINT_RELEASE"/*) ;;
    *) fail "Debian URL is not point-release pinned" ;;
esac
printf '%s' "$DEBIAN_NETINST_SHA256" | grep -Eq '^[0-9a-f]{64}$' ||
    fail "invalid Debian SHA-256"
printf '%s' "$DEBIAN_SNAPSHOT" | grep -Eq '^[0-9]{8}T[0-9]{6}Z$' ||
    fail "invalid Debian snapshot timestamp"
printf '%s' "$SIMPLE_CDD_VERSION" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' ||
    fail "invalid Simple-CDD version"
printf '%s' "$TECHNITIUM_VERSION" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' ||
    fail "invalid Technitium version"
printf '%s' "$TECHNITIUM_INDEX_DIGEST" | grep -Eq '^sha256:[0-9a-f]{64}$' ||
    fail "invalid Technitium index digest"
printf '%s' "$TECHNITIUM_AMD64_DIGEST" | grep -Eq '^sha256:[0-9a-f]{64}$' ||
    fail "invalid Technitium amd64 digest"
printf '%s' "$TAILSCALE_VERSION" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' ||
    fail "invalid Tailscale version"
case "$TAILSCALE_AMD64_URL" in
    https://pkgs.tailscale.com/stable/tailscale_"$TAILSCALE_VERSION"_amd64.tgz) ;;
    *) fail "Tailscale URL is not version pinned" ;;
esac
printf '%s' "$TAILSCALE_AMD64_SHA256" | grep -Eq '^[0-9a-f]{64}$' ||
    fail "invalid Tailscale SHA-256"

echo "source locks: valid"
